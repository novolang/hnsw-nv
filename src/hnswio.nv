// hnswio.nv — the serialised form: an index written into a caller's
// buffer and read back, with a magic and a version on the front.
//
// hnswlib's `saveIndex` writes its own memory: the element size, then
// the per-element blocks as the process laid them out, with no magic, no
// version and no dimension.  A file read by the wrong build produces an
// index rather than an error.  This format has a magic, a version, every
// parameter, and every field at a stated width, little-endian.  A file
// it did not write is refused at the fourth byte, and a file it did
// write reads back equal to the index that wrote it.
//
// The layout, with every integer a signed 64-bit value unless it says
// otherwise:
//
//     offset  field
//     0       magic, 4 bytes: "NVHW"
//     4       format version, 32 bits
//     8       dim
//     16      element count, deleted ones included
//     24      metric code, 32 bits
//     28      M, 32 bits
//     32      ef_construction
//     40      total bytes, this header included
//     48      capacity
//     56      level multiplier, a 64-bit IEEE 754 float
//     64      entry point
//     72      top level
//     80      slots reused by `insert_replacing`
//     88      length of the link list
//     96      the vectors, `count * dim` 64-bit floats
//             the labels, `count` values
//             the marks, `count` bytes, 1 for deleted
//             the levels, `count` values
//             the link counts, one per element per level
//             the links
//
// Where each element's links start is not stored: it follows from the
// levels.  The vectors are 64-bit floats, so a million of 768
// coordinates is 6 GB.  Writing them narrower would round every vector
// and produce an index that is not the one that was saved.

use std.list
use std.bytes
use std.float
use hnswparam
use hnswdist
use hnswgraph

// What a serialised index says about itself before its bytes.
//
// `peek_header` reads it without reading the index.  A cache
// validating an entry reads 48 bytes to learn whether the dimension, the
// metric and the format version still match what it will search.
//
// ```novo
// use hnswio
//
// fn main() [io]
//     println("${hnswio.header_bytes()}")
//     // : 48
// ```
pub struct HnswFileHeader
    // The format version — `format_version` is what this package
    // writes.
    version: Int
    // The vectors' length.
    dim: Int
    // The metric's code — `hnswdist.metric_of_code` turns it back.
    metric: Int
    // How many elements, deleted ones included.
    count: Int
    // The `M` the index was built with.
    m: Int
    // The `ef_construction` it was built with.
    ef_construction: Int
    // How many bytes the whole serialised index is, this header
    // included, so a caller reading from a stream knows how much to
    // read.
    total_bytes: Int

// The four magic bytes, "NVHW", as a little-endian 32-bit integer.
pub fn magic_le() -> Int
    0x5748564E

// The format version this package writes: 1.
//
// Raised when a field is added, removed or widened.  A reader refuses a
// version it does not know rather than reading the fields it
// recognises.
pub fn format_version() -> Int
    1

// The versions this package reads.
pub fn supported_versions() -> [Int]
    [1]

// How many bytes the header occupies: 48.
pub fn header_bytes() -> Int
    48

// Exactly how many bytes this index serialises to.
//
// Exact rather than an upper bound: every field is a stated width times
// a known count, as the module comment lays out.  The index is not
// checked; `hnswgraph.check` does that.
pub fn size_bound(ix: HnswIndex) -> Result<Int, HnswFault>
    let n = hnswgraph.count(ix)
    Ok(96 + n * ix.params.dim * 8 + n * 8 + n + n * 8 + list.len(ix.link_counts) * 8
       + list.len(ix.links) * 8)

// The index's bytes.
//
// ```novo
// use hnswio
// use hnswgraph
// use hnswparam
//
// fn main() [io]
//     match hnswparam.default_params(2, HnswL2)
//         Err(f) => println(f.message())
//         Ok(p)  =>
//             match hnswio.to_bytes(hnswgraph.index(p))
//                 Ok(b)  => println("${bytes.len(b) >= hnswio.header_bytes()}")
//                 Err(f) => println(f.message())
// ```
pub fn to_bytes(ix: HnswIndex) -> Result<Bytes, HnswFault>
    let size = size_bound(ix)!
    var out = bytes.zeros(size)
    write_into(ix, out, size)!
    Ok(out)

// The index written into a buffer the caller sized.
//
// `HnswOutputFull` with both numbers when `room`, or the buffer's own
// length if that is smaller, is less than `size_bound`, and the count
// written when it is not.  The buffer is written from offset 0, is not
// resized, and nothing past that count is touched.
pub fn write_into(ix: HnswIndex, var into: Bytes, room: Int) -> Result<Int, HnswFault>
    let size = size_bound(ix)!
    let have = if bytes.len(into) < room
        bytes.len(into)
    else
        room
    if have < size
        return Err(HnswOutputFull(size, have))
    let p = ix.params
    let n = hnswgraph.count(ix)
    bytes.set_u32_le(into, 0, magic_le())
    bytes.set_u32_le(into, 4, format_version())
    bytes.set_u64_le(into, 8, p.dim)
    bytes.set_u64_le(into, 16, n)
    bytes.set_u32_le(into, 24, hnswdist.metric_code(p.metric))
    bytes.set_u32_le(into, 28, p.m)
    bytes.set_u64_le(into, 32, p.ef_construction)
    bytes.set_u64_le(into, 40, size)
    bytes.set_u64_le(into, 48, p.capacity)
    bytes.set_u64_le(into, 56, float.to_bits(p.level_multiplier))
    bytes.set_u64_le(into, 64, ix.entry)
    bytes.set_u64_le(into, 72, ix.top_level)
    bytes.set_u64_le(into, 80, ix.replaced)
    bytes.set_u64_le(into, 88, list.len(ix.links))
    var at = 96
    for x in ix.data
        bytes.set_u64_le(into, at, float.to_bits(x))
        at = at + 8
    at = put_ints(into, at, ix.labels)
    for d in ix.deleted
        bytes.set_u8(into, at, (if d then 1 else 0))
        at = at + 1
    at = put_ints(into, at, ix.levels)
    at = put_ints(into, at, ix.link_counts)
    at = put_ints(into, at, ix.links)
    Ok(at)

// The header, from the first `header_bytes` of a serialised index.
//
// `HnswBadMagic` when the four bytes are not this format's,
// `HnswBadVersion` for a version this package does not read, and
// `HnswTruncated` when there are fewer than 48 bytes.
//
// The call a cache makes before it reads the rest: the dimension and the
// metric are here, and an entry built for a different model is
// discarded without being parsed.
pub fn peek_header(b: Bytes) -> Result<HnswFileHeader, HnswFault>
    if bytes.len(b) < 48
        return Err(HnswTruncated(bytes.len(b), 48 - bytes.len(b)))
    let magic = u32_at(b, 0)
    if magic != magic_le()
        return Err(HnswBadMagic(magic))
    let version = u32_at(b, 4)
    if not list.contains(supported_versions(), version)
        return Err(HnswBadVersion(version))
    Ok(HnswFileHeader { version: version, dim: i64_at(b, 8), metric: u32_at(b, 24),
                        count: i64_at(b, 16), m: u32_at(b, 28), ef_construction: i64_at(b, 32),
                        total_bytes: i64_at(b, 40) })

// The index, from its bytes.
//
// The faults of `peek_header`, then `HnswTruncated` when there are fewer
// bytes than the header's total, and `HnswCorruptGraph` for a header
// whose parameters or sizes do not describe an index: "params",
// "level_multiplier", "count" or "total_bytes".  It runs
// `hnswgraph.check` before it answers, so a file that reads back into an
// inconsistent graph is refused here rather than answering worse.
pub fn from_bytes(b: Bytes) -> Result<HnswIndex, HnswFault>
    let h = peek_header(b)!
    if bytes.len(b) < h.total_bytes
        return Err(HnswTruncated(bytes.len(b), h.total_bytes - bytes.len(b)))
    let p = params_of(b, h)!
    let n = h.count
    let links_len = i64_at(b, 88)
    // Every element costs at least its vector, its label, its mark, its
    // level and one link count, so the header's counts are checked
    // against the total, one bound at a time so that no product can
    // overflow, before anything is read.
    let total = h.total_bytes
    if p.dim > total / 8 or n < 0 or n > total / (p.dim * 8 + 25) or links_len < 0
       or links_len > total / 8 or 96 + n * (p.dim * 8 + 25) + links_len * 8 > total
        return Err(HnswCorruptGraph("count", n))
    var at = 96
    var data: [Float] = []
    for _ in 0..n * p.dim
        list.push(data, float.from_bits(i64_at(b, at)))
        at = at + 8
    let labels = ints_at(b, at, n)
    at = at + n * 8
    let deleted = list.range(0, n) |> list.map(i => byte_at(b, at + i) != 0)
    at = at + n
    let levels = ints_at(b, at, n)
    at = at + n * 8
    var counts_len = 0
    var starts: [Int] = []
    var start = 0
    for l in levels
        if l < 0 or l > h.total_bytes
            return Err(HnswCorruptGraph("level", l))
        list.push(starts, start)
        start = start + 2 * p.m + p.m * l
        counts_len = counts_len + l + 1
    if at + counts_len * 8 + links_len * 8 != h.total_bytes
        return Err(HnswCorruptGraph("total_bytes", h.total_bytes))
    let counts = ints_at(b, at, counts_len)
    at = at + counts_len * 8
    let links = ints_at(b, at, links_len)
    let ix = HnswIndex { params: p, data: data, labels: labels, deleted: deleted, levels: levels,
                         link_starts: starts, links: links, link_counts: counts,
                         entry: i64_at(b, 64), top_level: i64_at(b, 72), replaced: i64_at(b, 80) }
    hnswgraph.check(ix)!
    Ok(ix)

// Whether these bytes start with this format's magic.
//
// Four bytes are enough, for a caller sorting a directory of cache
// files.
pub fn is_index(b: Bytes) -> Bool
    bytes.len(b) >= 4 and u32_at(b, 0) == magic_le()

// Whether a serialised index can be searched with these parameters.
//
// The dimension and the metric must match.  `M` and `ef_construction`
// need not, because they shaped the graph that was saved and do not
// constrain a search of it.
pub fn header_matches(h: HnswFileHeader, p: HnswParams) -> Bool
    h.dim == p.dim and h.metric == hnswdist.metric_code(p.metric)

// The parameters a header and the fixed fields after it describe, or
// `HnswCorruptGraph` when they describe none.
fn params_of(b: Bytes, h: HnswFileHeader) -> Result<HnswParams, HnswFault>
    let metric = match hnswdist.metric_of_code(h.metric)
        Ok(m)  => m
        Err(_) =>
            return Err(HnswCorruptGraph("params", 24))
    let p = match hnswparam.params(h.dim, metric, h.m, h.ef_construction, i64_at(b, 48))
        Ok(p)  => p
        Err(_) =>
            return Err(HnswCorruptGraph("params", 8))
    match hnswparam.with_level_multiplier(p, float.from_bits(i64_at(b, 56)))
        Ok(q)  => Ok(q)
        Err(_) => Err(HnswCorruptGraph("level_multiplier", 56))

fn put_ints(var into: Bytes, from: Int, xs: [Int]) -> Int
    var at = from
    for x in xs
        bytes.set_u64_le(into, at, x)
        at = at + 8
    at

// The reads below are at offsets the caller has checked against the
// buffer's length.
fn u32_at(b: Bytes, at: Int) -> Int
    bytes.u32_le_at(b, at) ?? 0

fn i64_at(b: Bytes, at: Int) -> Int
    bytes.u64_le_at(b, at) ?? 0

fn byte_at(b: Bytes, at: Int) -> Int
    bytes.byte_at(b, at) ?? 0

fn ints_at(b: Bytes, from: Int, count: Int) -> [Int]
    list.range(0, count) |> list.map(i => i64_at(b, from + i * 8))
