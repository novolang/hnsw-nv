// hnswdist.nv — the three distances, as an enum and as functions.
//
// Everything here is a distance, and smaller is nearer, because every
// comparison HNSW makes is a minimum: the priority queues keep the
// smallest and the greedy descent walks downhill.  The two
// similarity-shaped metrics are therefore stored in their distance
// forms:
//
//     squared L2      sum((a_i - b_i)^2)
//     cosine          1 - dot(a, b) / (|a| * |b|), in [0, 2]
//     inner product   1 - dot(a, b)
//
// Squared L2 is squared on purpose.  The square root is monotonic, so it
// changes no ordering and no graph, and it would cost a call per
// comparison.  `l2` is the real distance, for reporting.
//
// Inner product is the cosine distance on unit vectors and is not a
// metric on others: it breaks the triangle inequality, so a graph built
// on it has no proof behind its descent.  hnswlib's `InnerProductSpace`
// is the same definition.
//
// A row is a `[Float]`.  embeddings-nv computes the same three over
// `NdFloat`, and the definitions and the test vectors agree.
//
// Every function here refuses two vectors of different lengths with
// `HnswDimMismatch`, a coordinate that is not a finite number with
// `HnswNotFinite` at its position in the left vector and then the
// right, and a zero vector under cosine with `HnswZeroNorm`.

use std.list
use std.math

// Which distance an index compares by.
//
// Fixed when the index is built, and serialised with it, because the
// graph's edges were chosen under it.
//
// ```novo
// use hnswdist
//
// fn main() [io]
//     println(hnswdist.metric_name(HnswCosine))
//     // : cosine
// ```
pub enum HnswMetric
    // Squared Euclidean.  The default, the only one of the three that
    // is a true metric on any input, and the one to use when the
    // vectors are not normalised and their magnitude means something.
    HnswL2
    // `1 - cos(a, b)`.  What almost every text embedding wants, and
    // what a model card means when it says "use cosine similarity".
    HnswCosine
    // `1 - dot(a, b)`.  The same as cosine for normalised vectors and
    // cheaper, because it skips two norms; not a metric otherwise.
    HnswInner

// The metric's name, lower case: "l2", "cosine", "inner".
//
// The spelling a command line or a configuration file uses.
pub fn metric_name(m: HnswMetric) -> Str
    match m
        HnswL2     => "l2"
        HnswCosine => "cosine"
        HnswInner  => "inner"

// The metric a name spells, for a command line or a config file.
pub fn metric_of_name(name: Str) -> ?HnswMetric
    match name
        "l2"     => Some(HnswL2)
        "cosine" => Some(HnswCosine)
        "inner"  => Some(HnswInner)
        _        => None

// The code `hnswio` stores: 0 for L2, 1 for cosine, 2 for inner
// product.
pub fn metric_code(m: HnswMetric) -> Int
    match m
        HnswL2     => 0
        HnswCosine => 1
        HnswInner  => 2

// The metric a code names, or `HnswBadParam` naming "metric" for a code
// that names none.
pub fn metric_of_code(code: Int) -> Result<HnswMetric, HnswFault>
    match code
        0 => Ok(HnswL2)
        1 => Ok(HnswCosine)
        2 => Ok(HnswInner)
        _ => Err(HnswBadParam("metric", code))

// Whether this metric wants its vectors normalised before they go in.
//
// True for cosine and for inner product, false for L2.  This package
// does not normalise on the caller's behalf, and an inner-product index
// over vectors nobody normalised is the commonest way to get poor
// results out of one.
pub fn wants_normalized(m: HnswMetric) -> Bool
    match m
        HnswL2 => false
        _      => true

// The distance between two vectors under this metric.
//
// `HnswDimMismatch` when the lengths differ, `HnswNotFinite` at the
// first coordinate that is not a number, and `HnswZeroNorm` for a
// zero vector under cosine.
//
// ```novo
// use hnswdist
//
// fn main() [io]
//     match hnswdist.distance(HnswL2, [0.0, 0.0], [3.0, 4.0])
//         Ok(d)  => println("${d}")
//                   // : 25
//         Err(f) => println(f.message())
// ```
pub fn distance(m: HnswMetric, left: [Float], right: [Float]) -> Result<Float, HnswFault>
    check_pair(left, right)!
    match m
        HnswL2     => Ok(squared_of(left, right))
        HnswInner  => Ok(1.0 - dot_of(left, right))
        HnswCosine => cosine_of(left, right)

// Squared Euclidean distance: the sum of the squared differences.
//
// Squared on purpose: the square root changes no ordering.  An `HnswL2`
// index compares by this.
pub fn l2_squared(left: [Float], right: [Float]) -> Result<Float, HnswFault>
    distance(HnswL2, left, right)

// Euclidean distance: the square root of `l2_squared`.
//
// For a caller reporting a distance to a person.
pub fn l2(left: [Float], right: [Float]) -> Result<Float, HnswFault>
    Ok(math.sqrt(l2_squared(left, right)!))

// Cosine distance: `1 - cos(a, b)`, in [0, 2].
//
// `HnswZeroNorm` for a zero vector on either side.
pub fn cosine(left: [Float], right: [Float]) -> Result<Float, HnswFault>
    distance(HnswCosine, left, right)

// Inner-product distance: `1 - dot(a, b)`.
//
// No norms are computed.  On vectors that are not unit length it may be
// negative, and it breaks the triangle inequality.
pub fn inner(left: [Float], right: [Float]) -> Result<Float, HnswFault>
    distance(HnswInner, left, right)

// The dot product.
//
// For a caller re-ranking results with its own arithmetic.
pub fn dot(left: [Float], right: [Float]) -> Result<Float, HnswFault>
    check_pair(left, right)!
    Ok(dot_of(left, right))

// The Euclidean length of a vector.  `HnswNotFinite` at the first
// coordinate that is not a number.
pub fn norm(v: [Float]) -> Result<Float, HnswFault>
    check_finite(v)!
    Ok(math.sqrt(dot_of(v, v)))

// The vector scaled to unit length.
//
// `HnswZeroNorm` for a zero vector.  An index never does this on the
// caller's behalf: it would hand back a vector the caller did not
// store, and a caller comparing magnitudes would find them gone.
pub fn normalize(v: [Float]) -> Result<[Float], HnswFault>
    let n = norm(v)!
    if n == 0.0
        return Err(HnswZeroNorm)
    Ok(v |> list.map(x => x / n))

// Whether every coordinate is a finite number.
//
// The check every vector gets on the way into an index, for a caller
// filtering a batch before it inserts.
pub fn is_finite_vector(v: [Float]) -> Bool
    first_not_finite(v) < 0

// The position of the first coordinate that is not finite, or -1.
fn first_not_finite(v: [Float]) -> Int
    for i in 0..list.len(v)
        if math.is_nan(v[i]) or math.is_inf(v[i])
            return i
    0 - 1

fn check_finite(v: [Float]) -> Result<Unit, HnswFault>
    let at = first_not_finite(v)
    if at >= 0
        return Err(HnswNotFinite(at))
    Ok(())

// `Ok` when the two have one length and every coordinate is finite.
fn check_pair(left: [Float], right: [Float]) -> Result<Unit, HnswFault>
    if list.len(left) != list.len(right)
        return Err(HnswDimMismatch(list.len(left), list.len(right)))
    check_finite(left)!
    check_finite(right)

fn dot_of(a: [Float], b: [Float]) -> Float
    var s = 0.0
    for i in 0..list.len(a)
        s = s + a[i] * b[i]
    s

fn squared_of(a: [Float], b: [Float]) -> Float
    var s = 0.0
    for i in 0..list.len(a)
        let d = a[i] - b[i]
        s = s + d * d
    s

fn cosine_of(a: [Float], b: [Float]) -> Result<Float, HnswFault>
    let na = dot_of(a, a)
    let nb = dot_of(b, b)
    if na == 0.0 or nb == 0.0
        return Err(HnswZeroNorm)
    Ok(1.0 - dot_of(a, b) / (math.sqrt(na) * math.sqrt(nb)))
