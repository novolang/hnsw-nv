// hnswgraph.nv — the index itself: a value holding every vector, every
// link and nothing else.
//
// `insert` takes one uniform in (0, 1), and it is the whole of the
// randomness HNSW needs.  hnswlib holds a random number generator inside
// the index; this package cannot, because rand-nv is a `host` package
// and this is a `core` one.  So the draw is the caller's and
// `hnswparam.level_of` turns it into the level the element joins at.
// Everything else about an insert is deterministic, and an index built
// from a recorded list of uniforms is the same index on any machine.
//
// An index is a value.  Every function takes one and answers a new one,
// and nothing the caller holds is changed.  Each insert therefore copies
// the index's lists, so it costs time in proportion to the index's size
// as well as the search it runs.
//
// The insert is Algorithm 1 of Malkov and Yashunin, as hnswlib runs it.
// From the entry point it walks greedily down to one level above the new
// element's.  At each level from there down to 0 it searches with
// `ef_construction` candidates, keeps `M` of them with the neighbour
// selection heuristic of Algorithm 4, links the new element to them and
// each of them back to it.  A neighbour that already holds its maximum
// of links keeps the best of its old links and the new one, chosen by
// the same heuristic.  An element at a level above every other becomes
// the entry point.
//
// The links are one flat list.  Element `i`'s run starts at
// `link_starts[i]`: `2 * M` slots for level 0, then `M` for each level
// above, up to its own.  `link_counts` holds one count per element per
// level, in the same order, and says how many slots of each run are in
// use.  A neighbour is the slot of an element, not its label, so a hop
// needs no lookup.
//
// A delete is a mark.  The element keeps its vector and its links, and a
// search walks through it without answering it, as hnswlib does.
// Removing it would cut the graph.  `insert_replacing` reuses a marked
// slot.

use std.list
use hnswparam
use hnswwalk

// An HNSW index.
//
// The fields are public, so a tool inspecting an index, such as a level
// histogram or a degree distribution, needs no accessor per question.
//
// ```novo
// use hnswgraph
// use hnswparam
//
// fn main() [io]
//     match hnswparam.default_params(4, HnswL2)
//         Err(f) => println(f.message())
//         Ok(p)  => println("${hnswgraph.count(hnswgraph.index(p))}")
//                   // : 0
// ```
pub struct HnswIndex
    // What the index was built with.  Only `grow` changes it.
    params: HnswParams
    // Every vector, row-major and packed: element `i` occupies
    // `data[i * dim ..< (i + 1) * dim]`.
    data: [Float]
    // The caller's own id per element, in slot order.
    labels: [Int]
    // The mark per element.  A deleted element keeps its vector and
    // its links; it is skipped as a result and walked through as a
    // hop.
    deleted: [Bool]
    // The level each element was inserted at.  0 for most of them.
    levels: [Int]
    // Where each element's run of links starts in `links`.
    link_starts: [Int]
    // The adjacency, flattened as the module comment describes.  A
    // neighbour is a slot, not a label.
    links: [Int]
    // How many of each element's slots are in use at each of its
    // levels, element by element and level 0 first.
    link_counts: [Int]
    // Where a search starts: the index of an element on the top level.
    // -1 for an empty index.
    entry: Int
    // The highest level any element occupies.  -1 for an empty index.
    top_level: Int
    // How many times `insert_replacing` has reused a slot.  `drift`
    // reads it.
    replaced: Int

// An empty index with these parameters.
pub fn index(p: HnswParams) -> HnswIndex
    HnswIndex { params: p, data: [], labels: [], deleted: [], levels: [], link_starts: [],
                links: [], link_counts: [], entry: 0 - 1, top_level: 0 - 1, replaced: 0 }

// How many elements the index holds, deleted ones included.
//
// The number that matters for memory.  `live_count` is the one that
// matters for a search.
pub fn count(ix: HnswIndex) -> Int
    list.len(ix.labels)

// How many elements a search can return: `count` minus the marks.
pub fn live_count(ix: HnswIndex) -> Int
    count(ix) - deleted_count(ix)

// How many elements are marked deleted.
pub fn deleted_count(ix: HnswIndex) -> Int
    list.count(ix.deleted, d => d)

// The parameters the index was built with.
pub fn params_of(ix: HnswIndex) -> HnswParams
    ix.params

// Add an element, with the caller's uniform choosing its level.
//
// `u` is one number in (0, 1): a draw from a generator, a recorded value
// on a rebuild, or a written-down list in a test.  `hnswparam.level_of`
// turns it into the level.
//
// `HnswBadUniform` for a `u` outside (0, 1), `HnswDimMismatch` for a
// vector of the wrong length, `HnswNotFinite` for one holding a value
// that is not a number, `HnswZeroNorm` for a zero vector under cosine,
// `HnswDuplicateLabel` for a label the index already holds, deleted or
// not, and `HnswAtCapacity` when the index is full.  `grow` and
// `insert_replacing` are the answers to the last.
//
// ```novo
// use hnswgraph
// use hnswparam
//
// fn main() [io]
//     match hnswparam.default_params(2, HnswL2)
//         Err(f) => println(f.message())
//         Ok(p)  =>
//             match hnswgraph.insert(hnswgraph.index(p), 1, [0.0, 1.0], 0.5)
//                 Ok(ix) => println("${hnswgraph.count(ix)}")
//                           // : 1
//                 Err(f) => println(f.message())
// ```
pub fn insert(ix: HnswIndex, label: Int, v: [Float], u: Float) -> Result<HnswIndex, HnswFault>
    let level = hnswparam.level_of(u, ix.params.level_multiplier)!
    insert_at_level(ix, label, v, level)

// Add an element at a level the caller states outright.
//
// The half of `insert` with no randomness in it, for a rebuild from
// recorded levels and for a test that wants a graph of a known shape.
// `HnswBadParam` for a negative level, and otherwise the faults of
// `insert`.
pub fn insert_at_level(ix: HnswIndex, label: Int, v: [Float],
                       level: Int) -> Result<HnswIndex, HnswFault>
    if level < 0
        return Err(HnswBadParam("level", level))
    hnswwalk.check_query(ix.params, v)!
    if slot_of(ix, label) != None
        return Err(HnswDuplicateLabel(label))
    if count(ix) >= ix.params.capacity
        return Err(HnswAtCapacity(ix.params.capacity))
    Ok(add(ix, label, v, level))

// Add an element into a slot a deleted one is holding, or as a new one
// when there is none.
//
// How a long-running index reclaims space without a rebuild, as
// hnswlib's `replace_deleted` does.  A marked slot carrying the same
// label is taken first, and otherwise the first marked slot.  The new
// element keeps that slot's level, so `u` is used only when there is no
// marked slot and the element is inserted as new.  Its links are chosen
// again at every level it occupies, and the links other elements hold to
// the slot stay, now leading to the new vector.
//
// The graph this produces is not the one a fresh build would, and
// `drift` says how far the index has moved.  The faults are those of
// `insert`, and a live element carrying the label is
// `HnswDuplicateLabel`.
pub fn insert_replacing(ix: HnswIndex, label: Int, v: [Float],
                        u: Float) -> Result<HnswIndex, HnswFault>
    let level = hnswparam.level_of(u, ix.params.level_multiplier)!
    hnswwalk.check_query(ix.params, v)!
    let own = slot_of(ix, label)
    if let Some(s) = own
        if not ix.deleted[s]
            return Err(HnswDuplicateLabel(label))
        return Ok(reuse(ix, s, label, v))
    for s in 0..count(ix)
        if ix.deleted[s]
            return Ok(reuse(ix, s, label, v))
    insert_at_level(ix, label, v, level)

// Mark an element deleted.
//
// It keeps its vector and its links.  Searches walk through it and do
// not answer it.  `HnswNoSuchLabel` when nothing carries the label.
pub fn mark_deleted(ix: HnswIndex, label: Int) -> Result<HnswIndex, HnswFault>
    with_mark(ix, label, true)

// Clear an element's mark.
//
// Nothing was thrown away, so the element is back as it was.
// `HnswNoSuchLabel` when nothing carries the label.  Marking an element
// that is already marked, or clearing one that is not, is not a fault.
pub fn unmark_deleted(ix: HnswIndex, label: Int) -> Result<HnswIndex, HnswFault>
    with_mark(ix, label, false)

// Whether the element with this label is marked.  `HnswNoSuchLabel`
// when nothing carries the label.
pub fn is_deleted(ix: HnswIndex, label: Int) -> Result<Bool, HnswFault>
    let s = found(ix, label)!
    Ok(ix.deleted[s])

// Raise the capacity.
//
// `hnswparam.with_capacity` on the parameters, and `HnswBadParam` for a
// capacity below the current one.  Explicit rather than automatic, so
// the cost of having sized an index wrong is visible.
pub fn grow(ix: HnswIndex, capacity: Int) -> Result<HnswIndex, HnswFault>
    let p = hnswparam.with_capacity(ix.params, capacity)!
    Ok(HnswIndex { params: p, data: ix.data[:], labels: ix.labels[:], deleted: ix.deleted[:],
                   levels: ix.levels[:], link_starts: ix.link_starts[:], links: ix.links[:],
                   link_counts: ix.link_counts[:], entry: ix.entry, top_level: ix.top_level,
                   replaced: ix.replaced })

// The slot an element's label occupies, or `None`.
//
// A walk over the labels, so it costs time in proportion to the index's
// size.
pub fn slot_of(ix: HnswIndex, label: Int) -> ?Int
    for s in 0..list.len(ix.labels)
        if ix.labels[s] == label
            return Some(s)
    None

// The label in a slot.
//
// `HnswNoSuchLabel` with the slot for a slot out of range, since to a
// caller both failures mean the element is not here.
pub fn label_at(ix: HnswIndex, slot: Int) -> Result<Int, HnswFault>
    in_range(ix, slot)!
    Ok(ix.labels[slot])

// The vector stored under a label.
//
// A copy out of the flat buffer.  A caller reading thousands of rows
// walks `ix.data` from `vector_base` instead.  `HnswNoSuchLabel` when
// nothing carries the label.
pub fn vector_of(ix: HnswIndex, label: Int) -> Result<[Float], HnswFault>
    let s = found(ix, label)!
    Ok(hnswwalk.vector_at(ix, s))

// Where an element's vector starts in `data`.
//
// `slot * dim`, for a caller walking `ix.data` directly.
// `HnswNoSuchLabel` with the slot for a slot out of range.
pub fn vector_base(ix: HnswIndex, slot: Int) -> Result<Int, HnswFault>
    in_range(ix, slot)!
    Ok(slot * ix.params.dim)

// The level an element was inserted at.  `HnswNoSuchLabel` when nothing
// carries the label.
pub fn level_of_label(ix: HnswIndex, label: Int) -> Result<Int, HnswFault>
    let s = found(ix, label)!
    Ok(ix.levels[s])

// Where an element's links at a level start in `links`.
//
// The offset the module comment describes: `link_starts[slot]`, plus
// `2 * M` and `M` for each level between 1 and `level`.
// `HnswNoSuchLabel` for a slot out of range, and `HnswBadParam` for a
// level below 0 or above the element's own, since an element at level 1
// has no links at level 2.
pub fn link_base(ix: HnswIndex, slot: Int, level: Int) -> Result<Int, HnswFault>
    in_level(ix, slot, level)!
    Ok(hnswwalk.base_of(ix, slot, level))

// An element's neighbours at a level, as element indices.
//
// Slots and not labels, because that is what the graph stores.
// `label_at` converts one.  The faults of `link_base`.
pub fn neighbours(ix: HnswIndex, slot: Int, level: Int) -> Result<[Int], HnswFault>
    in_level(ix, slot, level)!
    Ok(hnswwalk.links_of(ix, slot, level))

// How many neighbours an element has at a level.  The faults of
// `link_base`.
pub fn degree(ix: HnswIndex, slot: Int, level: Int) -> Result<Int, HnswFault>
    in_level(ix, slot, level)!
    Ok(ix.link_counts[hnswwalk.count_at(ix, slot, level)])

// How many elements sit at or above each level, lowest first.
//
// Entry `l` counts the elements at level `l` or above, so entry 0 is the
// element count.  An empty index answers an empty list.  A histogram
// that is not geometric was built from uniforms that are not uniform,
// and `hnswparam.expected_at_level` is what to compare it with.
pub fn level_histogram(ix: HnswIndex) -> [Int]
    list.range(0, ix.top_level + 1) |> list.map(l => list.count(ix.levels, v => v >= l))

// Check the graph against itself.
//
// `HnswCorruptGraph` naming the first thing that does not hold, and the
// element or position it is at: "lengths" when a list's length does not
// match the element count, "level" for a level below 0, "top_level"
// when the top is not the highest level, "link_start" for a run that
// does not start where the levels before it end, "links" or
// "link_counts" for a list whose length does not match the levels,
// "entry" for an entry point that is not on the top level,
// "link_count" for a count above `hnswparam.max_links`, "neighbour" for
// a link off the end, to itself, repeated in one run, or to an element
// with no such level, and "label" for a label two elements carry.
// Answers the number of links checked when everything holds.
//
// Links are not required to be reciprocal: an element that shed a link
// to make room for a nearer one still has the other end pointing at it.
//
// `hnswio.from_bytes` runs this after it reads.  A corrupt HNSW does not
// crash, it answers worse, so the check has to be explicit.
pub fn check(ix: HnswIndex) -> Result<Int, HnswFault>
    let n = count(ix)
    let dim = ix.params.dim
    if list.len(ix.data) != n * dim or list.len(ix.deleted) != n or list.len(ix.levels) != n
       or list.len(ix.link_starts) != n
        return Err(HnswCorruptGraph("lengths", n))
    check_levels(ix)!
    check_runs(ix)!
    if n == 0
        if ix.entry != 0 - 1
            return Err(HnswCorruptGraph("entry", ix.entry))
        return Ok(0)
    if ix.entry < 0 or ix.entry >= n or ix.levels[ix.entry] != ix.top_level
        return Err(HnswCorruptGraph("entry", ix.entry))
    var checked = 0
    for i in 0..n
        for l in 0..ix.levels[i] + 1
            checked = checked + check_links(ix, i, l)!
    check_labels(ix)!
    Ok(checked)

// How far the index has drifted from a fresh build: the fraction of
// its slots that have been replaced or marked.
//
// `(marked + replaced) / count`, at most 1.0, and 0.0 for an empty
// index or one nothing has been deleted from.  When to rebuild depends
// on what the index is for, but past about half a fresh build is both
// smaller and better connected.
pub fn drift(ix: HnswIndex) -> Float
    let n = count(ix)
    if n == 0
        return 0.0
    let moved = (deleted_count(ix) + ix.replaced) as Float / n as Float
    if moved > 1.0
        1.0
    else
        moved

// The slot carrying `label`, or `HnswNoSuchLabel`.
fn found(ix: HnswIndex, label: Int) -> Result<Int, HnswFault>
    match slot_of(ix, label)
        Some(s) => Ok(s)
        None    => Err(HnswNoSuchLabel(label))

fn in_range(ix: HnswIndex, slot: Int) -> Result<Unit, HnswFault>
    if slot < 0 or slot >= count(ix)
        return Err(HnswNoSuchLabel(slot))
    Ok(())

fn in_level(ix: HnswIndex, slot: Int, level: Int) -> Result<Unit, HnswFault>
    in_range(ix, slot)!
    if level < 0 or level > ix.levels[slot]
        return Err(HnswBadParam("level", level))
    Ok(())

fn with_mark(ix: HnswIndex, label: Int, mark: Bool) -> Result<HnswIndex, HnswFault>
    let s = found(ix, label)!
    var deleted = ix.deleted[:]
    deleted[s] = mark
    Ok(HnswIndex { params: ix.params, data: ix.data[:], labels: ix.labels[:], deleted: deleted,
                   levels: ix.levels[:], link_starts: ix.link_starts[:], links: ix.links[:],
                   link_counts: ix.link_counts[:], entry: ix.entry, top_level: ix.top_level,
                   replaced: ix.replaced })

// A new element appended and linked in.  The vector and the label have
// been checked.
fn add(ix: HnswIndex, label: Int, v: [Float], level: Int) -> HnswIndex
    let p = ix.params
    let n = count(ix)
    var data = ix.data[:]
    list.append(data, v)
    var labels = ix.labels[:]
    list.push(labels, label)
    var deleted = ix.deleted[:]
    list.push(deleted, false)
    var levels = ix.levels[:]
    list.push(levels, level)
    var starts = ix.link_starts[:]
    list.push(starts, list.len(ix.links))
    var links = ix.links[:]
    for _ in 0..2 * p.m + p.m * level
        list.push(links, 0)
    var counts = ix.link_counts[:]
    for _ in 0..level + 1
        list.push(counts, 0)
    let g = HnswIndex { params: p, data: data, labels: labels, deleted: deleted, levels: levels,
                        link_starts: starts, links: links, link_counts: counts, entry: ix.entry,
                        top_level: ix.top_level, replaced: ix.replaced }
    if n > 0
        connect(g, links, counts, n, v, level, [ix.entry], ix.top_level)
    let raised = level > ix.top_level
    HnswIndex { params: p, data: data, labels: labels, deleted: deleted, levels: levels,
                link_starts: starts, links: links, link_counts: counts,
                entry: (if raised then n else ix.entry),
                top_level: (if raised then level else ix.top_level), replaced: ix.replaced }

// Link element `n`, whose vector is `v`, into the graph at every level
// from `level` down, Algorithm 1 from the entry points `from`.  `g`
// holds `links` and `counts`, so a write through them is seen through
// `g`.  At a level, a search reads only that level's links, and those
// are written only after the search.
fn connect(g: HnswIndex, var links: [Int], var counts: [Int], n: Int, v: [Float], level: Int,
           from: [Int], top: Int)
    let p = g.params
    var eps = from[:]
    for lc in list.rev(list.range(level + 1, top + 1))
        let near = hnswwalk.layer(g, v, eps, 1, lc, false, hnswwalk.keep_all)
        eps = near.slots[:]
    let lowest = if level < top
        level
    else
        top
    for lc in list.rev(list.range(0, lowest + 1))
        let near = hnswwalk.layer(g, v, eps, p.ef_construction, lc, true, hnswwalk.keep_all)
        let chosen = hnswwalk.select(g, without(near, n), p.m)
        write_run(g, links, counts, n, lc, chosen)
        for e in chosen
            link_back(g, links, counts, e, n, lc)
        if list.len(near.slots) > 0
            eps = near.slots[:]

// A search's answer with slot `n` left out, for a relink that must not
// link an element to itself.
fn without(f: Found, n: Int) -> Found
    var ds: [Float] = []
    var ss: [Int] = []
    for i in 0..list.len(f.slots)
        if f.slots[i] != n
            list.push(ds, f.dists[i])
            list.push(ss, f.slots[i])
    Found { dists: ds, slots: ss }

// Replace element `slot`'s links at `level` with `chosen`.
fn write_run(g: HnswIndex, var links: [Int], var counts: [Int], slot: Int, level: Int,
             chosen: [Int])
    let base = hnswwalk.base_of(g, slot, level)
    for i in 0..list.len(chosen)
        links[base + i] = chosen[i]
    counts[hnswwalk.count_at(g, slot, level)] = list.len(chosen)

// Give element `e` a link to `n` at `level`.  With room it is appended.
// Without, `e` keeps the best of its links and the new one, chosen by
// the neighbour heuristic from `e`'s own position.
fn link_back(g: HnswIndex, var links: [Int], var counts: [Int], e: Int, n: Int, level: Int)
    let have = hnswwalk.links_of(g, e, level)
    if list.contains(have, n)
        return
    let room = hnswparam.max_links(g.params, level)
    let c = list.len(have)
    if c < room
        links[hnswwalk.base_of(g, e, level) + c] = n
        counts[hnswwalk.count_at(g, e, level)] = c + 1
        return
    let own = hnswwalk.vector_at(g, e)
    var ranked: [(Float, Int)] = []
    for x in have
        list.push(ranked, (hnswwalk.to_slot(g, own, x), x))
    list.push(ranked, (hnswwalk.to_slot(g, own, n), n))
    list.sort(ranked)
    let near = Found { dists: ranked |> list.map(r => r.0), slots: ranked |> list.map(r => r.1) }
    write_run(g, links, counts, e, level, hnswwalk.select(g, near, room))

// Slot `s` given a new label and vector, unmarked, and linked again at
// every level it occupies.
fn reuse(ix: HnswIndex, s: Int, label: Int, v: [Float]) -> HnswIndex
    let p = ix.params
    var data = ix.data[:]
    for i in 0..p.dim
        data[s * p.dim + i] = v[i]
    var labels = ix.labels[:]
    labels[s] = label
    var deleted = ix.deleted[:]
    deleted[s] = false
    var links = ix.links[:]
    var counts = ix.link_counts[:]
    let g = HnswIndex { params: p, data: data, labels: labels, deleted: deleted,
                        levels: ix.levels[:], link_starts: ix.link_starts[:], links: links,
                        link_counts: counts, entry: ix.entry, top_level: ix.top_level,
                        replaced: ix.replaced + 1 }
    // The slot's old links stay in place during the searches, so a walk
    // that starts at this slot, the entry point among others, still
    // leads into the graph.  Each level's run is then overwritten.
    connect(g, links, counts, s, v, ix.levels[s], [ix.entry], ix.top_level)
    g

fn check_levels(ix: HnswIndex) -> Result<Unit, HnswFault>
    var top = 0 - 1
    for i in 0..list.len(ix.levels)
        if ix.levels[i] < 0
            return Err(HnswCorruptGraph("level", i))
        top = if ix.levels[i] > top
            ix.levels[i]
        else
            top
    if top != ix.top_level
        return Err(HnswCorruptGraph("top_level", ix.top_level))
    Ok(())

fn check_runs(ix: HnswIndex) -> Result<Unit, HnswFault>
    let m = ix.params.m
    var start = 0
    var counts = 0
    for i in 0..list.len(ix.levels)
        if ix.link_starts[i] != start
            return Err(HnswCorruptGraph("link_start", i))
        start = start + 2 * m + m * ix.levels[i]
        counts = counts + ix.levels[i] + 1
    if list.len(ix.links) != start
        return Err(HnswCorruptGraph("links", list.len(ix.links)))
    if list.len(ix.link_counts) != counts
        return Err(HnswCorruptGraph("link_counts", list.len(ix.link_counts)))
    Ok(())

// The links of element `i` at level `l` checked, answering how many.
fn check_links(ix: HnswIndex, i: Int, l: Int) -> Result<Int, HnswFault>
    let c = ix.link_counts[hnswwalk.count_at(ix, i, l)]
    if c < 0 or c > hnswparam.max_links(ix.params, l)
        return Err(HnswCorruptGraph("link_count", i))
    let run = hnswwalk.links_of(ix, i, l)
    let n = count(ix)
    for k in 0..c
        let x = run[k]
        if x < 0 or x >= n or x == i or list.contains(run[0:k], x)
            return Err(HnswCorruptGraph("neighbour", i))
        if ix.levels[x] < l
            return Err(HnswCorruptGraph("neighbour", i))
    Ok(c)

fn check_labels(ix: HnswIndex) -> Result<Unit, HnswFault>
    var sorted = ix.labels[:]
    list.sort(sorted)
    for i in 1..list.len(sorted)
        if sorted[i] == sorted[i - 1]
            return Err(HnswCorruptGraph("label", sorted[i]))
    Ok(())
