// hnswsearch.nv — k-nearest search, and the two layers of it the
// algorithm is made of.
//
// `ef` is the knob, and it is per query.  A search keeps a candidate
// list of `ef` elements as it descends: a larger one finds more and
// costs more, and `k` is only how many of them come back.  An `ef` below
// `k` could not return `k` answers, and it is refused.  Every other
// parameter is fixed when the index is built.
//
// The descent is Algorithm 5 of Malkov and Yashunin.  From the entry
// point, `greedy_step` walks each level above 0 to the element nearest
// the query, and `search_layer` then searches level 0 with the caller's
// `ef`.  Both are public, for a caller doing what the top-level calls do
// not cover, such as a sharded search or a recall harness that wants
// the candidates.
//
// A deleted element is walked through and not returned, as hnswlib
// does, so a search of an index that is mostly marks still costs what
// the graph costs.  `hnswgraph.drift` measures that.
//
// Results are sorted nearest first, and two at the same distance by
// slot.  They carry the distance the index compared by, under its
// metric: squared for L2, and `1 - similarity` for the other two.

use std.list
use hnswparam
use hnswgraph
use hnswwalk

// One answer: a label and how far it was.
//
// The distance is under the index's own metric, squared for L2.
// `hnswdist.l2` is the real distance, for reporting to a person.
//
// ```novo
// use hnswsearch
//
// fn main() [io]
//     let h = HnswHit { label: 7, distance: 0.25 }
//     println("${h.label} at ${h.distance}")
// ```
pub struct HnswHit
    // The caller's own id, as it was handed to `insert`.
    label: Int
    // The distance under the index's metric.  Smaller is nearer.
    distance: Float

// One candidate during a descent: an element index and its distance.
//
// A slot rather than a label, because that is what the graph is
// addressed by.  `search_layer` answers these, and `search` converts to
// labels once, at the end.
pub struct HnswCandidate
    // The element's slot in the index, not its label.
    slot: Int
    // The distance under the index's metric.
    distance: Float

// The `k` nearest live elements to a query.
//
// Sorted nearest first, and shorter than `k` when fewer than `k` live
// elements are found.
//
// `HnswDimMismatch` for a query of the wrong length, `HnswNotFinite`
// for one holding a value that is not a number, `HnswZeroNorm` for a
// zero query under cosine, `HnswEmptyIndex` for an index with nothing
// in it, and `HnswBadParam` for a `k` below 1 or an `ef` below `k`.
//
// ```novo
// use hnswsearch
// use hnswgraph
// use hnswparam
//
// fn main() [io]
//     match hnswparam.default_params(2, HnswL2)
//         Err(f) => println(f.message())
//         Ok(p)  =>
//             match hnswsearch.search(hnswgraph.index(p), [0.0, 0.0], 1, 10)
//                 Ok(hits) => println("${list.len(hits)}")
//                 Err(f)   => println(f.message())
//                             // : an index with nothing in it
// ```
pub fn search(ix: HnswIndex, query: [Float], k: Int, ef: Int) -> Result<[HnswHit], HnswFault>
    descend(ix, query, k, ef, hnswwalk.keep_all)

// The `k` nearest, with `ef` chosen by `hnswparam.default_ef`.
//
// For a caller that has measured nothing yet.  The default is
// `max(k, ef_construction / 4)`, a starting point rather than a
// recommendation.
pub fn search_default(ix: HnswIndex, query: [Float], k: Int) -> Result<[HnswHit], HnswFault>
    search(ix, query, k, hnswparam.default_ef(ix.params, k))

// The `k` nearest live elements whose label `keep` accepts.
//
// The predicate takes the label, since a caller filtering by tenant or
// by permission keeps that in a table keyed by its own ids.
//
// The filter is applied at level 0 during the search, as hnswlib's
// `isIdAllowed` is: an element the filter rejects is walked through and
// not answered, and the search keeps walking until it holds `ef`
// accepted answers or has nothing left to explore.  Filtering afterwards
// would give fewer than `k` results whenever the filter is at all
// selective.  A filter that accepts almost nothing turns the search into
// a walk of the graph, and a caller whose filters are that selective
// wants one index per partition.  The faults are those of `search`.
pub fn search_filtered(ix: HnswIndex, query: [Float], k: Int, ef: Int,
                       keep: fn(Int) -> Bool) -> Result<[HnswHit], HnswFault>
    descend(ix, query, k, ef, keep)

// The best-first walk over one level, from one entry point, keeping `ef`
// candidates: Algorithm 2 of the paper.
//
// Answers candidates sorted nearest first, deleted elements included,
// since at this level they are hops.  The faults of `search` for the
// query, `HnswNoSuchLabel` with the slot for an entry out of range, and
// `HnswBadParam` for an `ef` below 1 or a level the entry does not
// occupy.
pub fn search_layer(ix: HnswIndex, query: [Float], entry: Int, ef: Int,
                    level: Int) -> Result<[HnswCandidate], HnswFault>
    hnswwalk.check_query(ix.params, query)!
    if ef < 1
        return Err(HnswBadParam("ef", ef))
    hnswgraph.degree(ix, entry, level)!
    let f = hnswwalk.layer(ix, query, [entry], ef, level, false, hnswwalk.keep_all)
    Ok(list.range(0, list.len(f.slots))
       |> list.map(i => HnswCandidate { slot: f.slots[i], distance: f.dists[i] }))

// The nearest single element on a level, walking greedily from an
// entry point.
//
// `search_layer` with `ef = 1`, which is what the descent through the
// upper levels does.  Answers the slot.
pub fn greedy_step(ix: HnswIndex, query: [Float], entry: Int, level: Int) -> Result<Int, HnswFault>
    let found = search_layer(ix, query, entry, 1, level)!
    Ok(found[0].slot)

// The exact `k` nearest, by comparing the query with every live
// element.
//
// No graph and no approximation, at a cost linear in the index's size:
// the answer a recall measurement compares with, and the right search
// for an index small enough that the graph is not worth descending.
// Ties are broken by slot.  The faults of `search` for `k` and the
// query, and `HnswEmptyIndex` for an index with nothing in it.
pub fn brute_force(ix: HnswIndex, query: [Float], k: Int) -> Result<[HnswHit], HnswFault>
    if k < 1
        return Err(HnswBadParam("k", k))
    hnswwalk.check_query(ix.params, query)!
    if hnswgraph.count(ix) == 0
        return Err(HnswEmptyIndex)
    var ranked: [(Float, Int)] = []
    for s in 0..hnswgraph.count(ix)
        if not ix.deleted[s]
            list.push(ranked, (hnswwalk.to_slot(ix, query, s), s))
    list.sort(ranked)
    let take = if k < list.len(ranked)
        k
    else
        list.len(ranked)
    Ok(ranked[0:take] |> list.map(r => HnswHit { label: ix.labels[r.1], distance: r.0 }))

// The distance from a query to one labelled element.
//
// For a caller with a result set from somewhere else, such as a keyword
// search, that wants the index's own arithmetic over it.  The faults of
// `search` for the query, and `HnswNoSuchLabel`.
pub fn distance_to(ix: HnswIndex, query: [Float], label: Int) -> Result<Float, HnswFault>
    hnswwalk.check_query(ix.params, query)!
    let Some(s) = hnswgraph.slot_of(ix, label) else return Err(HnswNoSuchLabel(label))
    Ok(hnswwalk.to_slot(ix, query, s))

// The fraction of an exact result the approximate one found.
//
// `|approx ∩ exact| / |exact|`, by label, which is what "recall@k"
// means.  1.0 when the approximate search found every one, and 0.0 for
// an empty exact set, so a harness never reports perfect recall over a
// query that matched nothing.  A caller tuning `ef` runs `search` and
// `brute_force` over a sample of real queries and reads the curve.
//
// ```novo
// use hnswsearch
//
// fn main() [io]
//     println("${hnswsearch.recall_at([], [])}")
//     // : 0
// ```
pub fn recall_at(approx: [HnswHit], exact: [HnswHit]) -> Float
    if list.len(exact) == 0
        return 0.0
    let found = hit_labels(approx)
    let hits = list.count(exact, h => list.contains(found, h.label))
    hits as Float / list.len(exact) as Float

// The labels of a result set, in order.
//
// For a caller joining the answers back to its own records.
pub fn hit_labels(hits: [HnswHit]) -> [Int]
    hits |> list.map(h => h.label)

// How many distance computations a search of this index with this `ef`
// is expected to make.
//
// An estimate from the index's own degrees: the mean degree at each
// level above 0, one greedy hop per level, plus `ef` times the mean
// degree at level 0.  It leaves out the extra hops a greedy walk takes
// and the candidates a level-0 search expands past `ef`, so it is a
// shape to compare values of `ef` by rather than a count.  0.0 for an
// empty index.
pub fn expected_comparisons(ix: HnswIndex, ef: Int) -> Float
    var total = 0.0
    for l in 0..ix.top_level + 1
        let per = mean_degree(ix, l)
        total = total + (if l == 0 then per * ef as Float else per)
    total

fn mean_degree(ix: HnswIndex, level: Int) -> Float
    var sum = 0
    var n = 0
    for s in 0..hnswgraph.count(ix)
        if ix.levels[s] >= level
            sum = sum + ix.link_counts[hnswwalk.count_at(ix, s, level)]
            n = n + 1
    sum as Float / n as Float

// The descent, with `keep` applied at level 0.
fn descend(ix: HnswIndex, query: [Float], k: Int, ef: Int,
           keep: fn(Int) -> Bool) -> Result<[HnswHit], HnswFault>
    if k < 1
        return Err(HnswBadParam("k", k))
    if ef < k
        return Err(HnswBadParam("ef", ef))
    hnswwalk.check_query(ix.params, query)!
    if hnswgraph.count(ix) == 0
        return Err(HnswEmptyIndex)
    var eps = [ix.entry]
    for l in list.rev(list.range(1, ix.top_level + 1))
        eps = hnswwalk.layer(ix, query, eps, 1, l, false, hnswwalk.keep_all).slots[:]
    let f = hnswwalk.layer(ix, query, eps, ef, 0, true, keep)
    let take = if k < list.len(f.slots)
        k
    else
        list.len(f.slots)
    Ok(list.range(0, take) |> list.map(i => HnswHit { label: ix.labels[f.slots[i]],
                                                      distance: f.dists[i] }))
