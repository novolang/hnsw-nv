// hnswparam.nv — the build parameters, and the formula that turns a
// uniform into a level.
//
// HNSW is a stack of graphs.  Level 0 holds every element, and each
// level above holds a geometrically thinning sample, so a search starts
// at the top with a handful of elements and descends.  The level an
// element joins at is Algorithm 1 of Malkov and Yashunin:
//
//     level = floor(-ln(u) * mL)        with u uniform in (0, 1)
//
// `mL` is the level multiplier.  The paper recommends `1 / ln(M)`,
// which puts an element at or above level `l` with probability `M^-l`.
//
// The uniform is the caller's.  rand-nv is a `host` package, because its
// entropy comes from the machine, and a `core` package may not depend
// on a `host` one.  So `hnswgraph.insert` takes one number in (0, 1)
// and `level_of` turns it into a level.  The same uniforms build the
// same graph on every machine.

use std.math

// What an index was built with.
//
// Fixed at construction and serialised with the index, because every
// one of them shaped the graph.
//
// ```novo
// use hnswparam
//
// fn main() [io]
//     match hnswparam.params(768, HnswCosine, 16, 200, 10000)
//         Ok(p)  => println("${p.m}")
//         Err(f) => println(f.message())
// ```
pub struct HnswParams
    // How many numbers a vector has.  Every vector handed to this
    // index must have exactly this many.
    dim: Int
    // Which distance the graph was built under.
    metric: HnswMetric
    // The number of links per element per level above zero.  It trades
    // memory for recall: 16 is hnswlib's default, 8 is thin and fast,
    // and 64 suits a high-recall index over a hard dataset.
    m: Int
    // The candidate-list size during construction.  Larger builds a
    // better graph and takes longer; it does not change the index's
    // size.  200 is hnswlib's default.
    ef_construction: Int
    // How many elements the index was sized for.  An insert past it is
    // `HnswAtCapacity`, and `hnswgraph.grow` raises it.
    capacity: Int
    // `mL` in the paper: the level multiplier `level_of` uses.  A field,
    // so that a serialised index reads back at the multiplier it was
    // built with.
    level_multiplier: Float

// Parameters, checked.
//
// `HnswBadParam` naming the field for: a dimension below 1; an `m`
// outside `2 ..= 128`; an `ef_construction` below `m`; a capacity
// below 1.  The level multiplier is `default_level_multiplier(m)`;
// `with_level_multiplier` overrides it.
pub fn params(dim: Int, metric: HnswMetric, m: Int, ef_construction: Int,
              capacity: Int) -> Result<HnswParams, HnswFault>
    if dim < 1
        return Err(HnswBadParam("dim", dim))
    if m < 2 or m > 128
        return Err(HnswBadParam("M", m))
    if ef_construction < m
        return Err(HnswBadParam("ef_construction", ef_construction))
    if capacity < 1
        return Err(HnswBadParam("capacity", capacity))
    Ok(HnswParams { dim: dim, metric: metric, m: m, ef_construction: ef_construction,
                    capacity: capacity, level_multiplier: default_level_multiplier(m) })

// hnswlib's defaults for this dimension and metric: M 16,
// ef_construction 200, capacity 1024.
//
// The parameters to start from.  `HnswBadParam` for a dimension below
// 1.
pub fn default_params(dim: Int, metric: HnswMetric) -> Result<HnswParams, HnswFault>
    params(dim, metric, 16, 200, 1024)

// The same parameters with a different level multiplier.
//
// `HnswBadParam` naming "level_multiplier", with a value of 0, for a
// multiplier that is not positive and finite.  The paper's `1 / ln(M)`
// is optimal for the search cost it analyses.
pub fn with_level_multiplier(p: HnswParams, ml: Float) -> Result<HnswParams, HnswFault>
    if not ml > 0.0 or math.is_inf(ml)
        return Err(HnswBadParam("level_multiplier", 0))
    Ok(HnswParams { dim: p.dim, metric: p.metric, m: p.m, ef_construction: p.ef_construction,
                    capacity: p.capacity, level_multiplier: ml })

// The same parameters with a larger capacity.
//
// `HnswBadParam` for a capacity below the one it already has, since
// shrinking would have to decide which elements to drop.
pub fn with_capacity(p: HnswParams, capacity: Int) -> Result<HnswParams, HnswFault>
    if capacity < p.capacity
        return Err(HnswBadParam("capacity", capacity))
    Ok(HnswParams { dim: p.dim, metric: p.metric, m: p.m, ef_construction: p.ef_construction,
                    capacity: capacity, level_multiplier: p.level_multiplier })

// `1 / ln(M)`, the paper's recommendation.  An `m` below 2 is taken as
// 2, the smallest `params` accepts.
//
// ```novo
// use hnswparam
//
// fn main() [io]
//     println("${hnswparam.default_level_multiplier(16) > 0.0}")
//     // : true
// ```
pub fn default_level_multiplier(m: Int) -> Float
    let links = if m < 2
        2
    else
        m
    1.0 / math.log(links as Float)

// The level a uniform buys: `floor(-ln(u) * ml)`.
//
// `HnswBadUniform` for a `u` outside the open interval (0, 1): 1.0,
// whose logarithm is zero and which would put every element on level 0,
// and 0.0, whose logarithm is not finite.  A generator whose range
// includes 0.0 draws again, or passes `1.0 - u`.  `HnswBadParam` naming
// "level_multiplier" for an `ml` that is not positive and finite.
//
// At the default multiplier an element reaches level 1 with
// probability `1/M`, level 2 with `1/M^2`, and so on: in an index of a
// million elements at M 16, about sixty thousand reach level 1 and four
// thousand level 2.
//
// ```novo
// use hnswparam
//
// fn main() [io]
//     match hnswparam.level_of(0.5, 0.36)
//         Ok(l)  => println("${l >= 0}")
//                   // : true
//         Err(f) => println(f.message())
// ```
pub fn level_of(u: Float, ml: Float) -> Result<Int, HnswFault>
    if not (u > 0.0 and u < 1.0)
        return Err(HnswBadUniform(u))
    if not ml > 0.0 or math.is_inf(ml)
        return Err(HnswBadParam("level_multiplier", 0))
    Ok(math.floor(0.0 - math.log(u) * ml) as Int)

// How many links an element may hold at this level.
//
// `2 * M` at level 0 and `M` above it, hnswlib's `maxM0` and `maxM`.
// Level 0 holds every element and is where a query's answer is drawn
// from, so its connectivity is what recall is made of.
pub fn max_links(p: HnswParams, level: Int) -> Int
    if level == 0
        2 * p.m
    else
        p.m

// The `ef` a search uses when the caller does not choose one:
// `max(k, ef_construction / 4)`, and never below k.
//
// A default rather than a requirement: `ef` is the one knob a caller
// turns per query, and the right value depends on what the query is
// for.
pub fn default_ef(p: HnswParams, k: Int) -> Int
    let quarter = p.ef_construction / 4
    if k > quarter
        k
    else
        quarter

// How many bytes one element costs in the serialised form: its vector at
// 8 bytes a coordinate, its label and its level at 8 bytes each, its
// mark at 1, and at each level it occupies a link count and room for
// every link at 8 bytes each.
//
// `level` is the element's own, because an element at level 3 carries
// four link runs.  At 768 dimensions and M 16 the vector is 6,144 bytes
// and the level-0 links 256, and at 64 dimensions the links are close to
// half.
pub fn element_bytes(p: HnswParams, level: Int) -> Int
    let slots = 2 * p.m + p.m * level
    p.dim * 8 + 8 + 8 + 1 + (level + 1) * 8 + slots * 8

// The expected number of elements at or above a level, for an index of
// `count` elements.
//
// `count * exp(-level / mL)`, the geometric thinning the level
// multiplier produces, which is `count * (1/M)^level` at the default
// multiplier.  An index whose level histogram is nothing like this was
// fed uniforms that are not uniform.
pub fn expected_at_level(p: HnswParams, count: Int, level: Int) -> Float
    count as Float * math.exp(0.0 - level as Float / p.level_multiplier)
