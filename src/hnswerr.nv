// hnswerr.nv — what an index could not do, and the numbers that say
// why.
//
// Every body here is a `todo()`; the signatures are the design.
//
// THE FAULTS SPLIT INTO THREE GROUPS AND THE MESSAGE SAYS WHICH.  A
// parameter the caller chose (`HnswBadParam`, `HnswBadUniform`), a
// vector that does not fit the index it was handed to
// (`HnswDimMismatch`, `HnswNotFinite`), and a lookup that found
// nothing (`HnswNoSuchLabel`, `HnswEmptyIndex`).  The first group is a
// bug in the calling code, the second is a bug in the pipeline that
// produced the vector, and the third is ordinary.
//
// `is_usage` is that split made callable, because the three want
// different handling: a usage fault should stop a program, a data
// fault should be counted and the row skipped, and a lookup fault is
// often just an answer.

// What an index refused, and the numbers that made it refuse.
//
// ```novo
// use hnswerr
//
// fn main() [io]
//     let f = HnswDimMismatch(768, 384)
//     println(f.message())
// ```
pub enum HnswFault
    // A build parameter outside its range.  `what` names it — "M",
    // "ef_construction", "dim", "ef" — and `value` is what was asked
    // for.  Every bound is in `hnswparam`, and each is a bound for a
    // reason the page gives rather than a number somebody liked.
    HnswBadParam(what: Str, value: Int)
    // The uniform handed to an insert was not in [0, 1).  A fault
    // rather than a clamp: the number decides which level an element
    // is inserted at, a clamped 1.0 puts every element on level 0, and
    // an index built that way is a linked list that answers every
    // query by scanning it.
    HnswBadUniform(value: Float)
    // A vector of the wrong length.  The commonest fault there is, and
    // almost always one model's output handed to an index built for
    // another's — 768 against 384 is `all-mpnet` against `all-MiniLM`.
    HnswDimMismatch(want: Int, got: Int)
    // A vector holding a value that is not finite.  `at` is the
    // coordinate.  Refused rather than stored, because one NaN in an
    // index poisons every comparison it takes part in: a distance to
    // NaN is NaN, NaN sorts unpredictably, and the graph that gets
    // built has edges nobody can explain.
    HnswNotFinite(at: Int)
    // A vector of all zeros handed to a cosine index.  Cosine is
    // undefined there — the norm is zero and the division is not — and
    // the alternatives are worse than a fault: 0.0 makes it maximally
    // similar to everything and 1.0 makes it maximally distant from
    // everything, and both are wrong in a way that shows up as bad
    // results rather than as an error.
    HnswZeroNorm
    // A label no element in the index carries.
    HnswNoSuchLabel(label: Int)
    // A label an element already carries, on an insert.  Labels are
    // the caller's own ids and this package does not pick them, so a
    // repeat is a caller that lost track — and silently replacing
    // would leave the old vector's edges in the graph, pointing at a
    // row that means something else.
    HnswDuplicateLabel(label: Int)
    // A search of an index with nothing in it.  Not a corruption, and
    // `is_usage` answers false: an empty result would be a defensible
    // answer, and this is the more useful one because the usual cause
    // is a build that silently failed upstream.
    HnswEmptyIndex
    // An index that has reached the capacity it was built with.
    // `hnswparam.HnswParams.capacity` is the number, and
    // `hnswgraph.grow` is what raises it.
    HnswAtCapacity(capacity: Int)
    // A serialised index whose first bytes are not this format's.
    // `got` is the little-endian reading of the four magic bytes, so a
    // caller who handed over an hnswlib `.bin` sees a number they can
    // recognise rather than a shrug — and hnswlib's own file is a raw
    // memory dump with no magic at all, which is exactly why this
    // format has one.
    HnswBadMagic(got: Int)
    // A serialised index from a version of this format that this
    // package does not read.  `hnswio.format_version` is what it
    // writes.
    HnswBadVersion(version: Int)
    // A serialised index that ran out of bytes.  `at` is where the
    // read stopped and `want` is how many more it needed.
    HnswTruncated(at: Int, want: Int)
    // A serialised index that read back inconsistent: a neighbour
    // index off the end, a level above the top, a link count above
    // the parameter.  `what` names the field.  The check is worth
    // making because the graph is the only part a corrupt file can
    // damage in a way that produces answers rather than a crash.
    HnswCorruptGraph(what: Str, at: Int)
    // A writer was handed `room` bytes and needed `want`.  Answers
    // FALSE to `is_usage`: a buffer too small is a sizing decision,
    // and `hnswio.size_bound` is the number to have asked for.
    HnswOutputFull(want: Int, room: Int)

// The rule every `HnswFault` is printed by: name what was compared,
// and print both sides.
//
// `Result<T, E>` requires `E: Error` (SPEC § 3.4), so this impl is what
// makes every fallible signature in the package spellable — it exists
// whether or not an interface release has anything to say yet.
impl Error for HnswFault
    fn message(self) -> Str
        match self
            HnswBadParam(what, value)  => "${what} of ${value} is out of range"
            HnswBadUniform(value)      => "a uniform of ${value} is not in [0, 1)"
            HnswDimMismatch(want, got) => "a vector of ${got} into an index of ${want}"
            HnswNotFinite(at)          => "coordinate ${at} is not a finite number"
            HnswZeroNorm               => "cosine distance is undefined for a zero vector"
            HnswNoSuchLabel(label)     => "no element labelled ${label}"
            HnswDuplicateLabel(label)  => "an element is already labelled ${label}"
            HnswEmptyIndex             => "an index with nothing in it"
            HnswAtCapacity(capacity)   => "the index holds its full ${capacity}"
            HnswBadMagic(got)          => "not a serialised index: first four bytes read ${got}"
            HnswBadVersion(version)    => "index format ${version} is not one this reader knows"
            HnswTruncated(at, want)    => "${want} more byte(s) wanted at ${at}"
            HnswCorruptGraph(what, at) => "${what} at ${at} does not describe this graph"
            HnswOutputFull(want, room) => "${want} byte(s) into room for ${room}"

// Whether the fault is a bug in the calling code rather than an
// ordinary answer or a sizing decision.
//
// True for the parameter and vector faults and for a duplicate label;
// false for `HnswNoSuchLabel`, `HnswEmptyIndex` and `HnswOutputFull`,
// each of which a correct program meets.  The split a caller wants at
// the top of a loop: stop on a usage fault, count and skip on a data
// one.
//
// ```novo
// use hnswerr
//
// fn main() [io]
//     println("${hnswerr.is_usage(HnswEmptyIndex)}")
//     // : false
// ```
pub fn is_usage(f: HnswFault) -> Bool
    todo("hnsw-nv.hnswerr.is_usage")

// Whether the fault came from reading a serialised index.
//
// The four `hnswio` faults.  For a caller that loads an index from a
// cache and rebuilds when it cannot: a load that fails this way is a
// cache to discard, and anything else is a bug to report.
pub fn is_format(f: HnswFault) -> Bool
    todo("hnsw-nv.hnswerr.is_format")
