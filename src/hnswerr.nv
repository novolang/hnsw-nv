// hnswerr.nv — what an index could not do, and the numbers that say
// why.
//
// The faults fall into groups a caller handles differently.  A
// parameter or a vector the caller chose (`HnswBadParam`,
// `HnswBadUniform`, `HnswDimMismatch`, `HnswNotFinite`, `HnswZeroNorm`,
// `HnswDuplicateLabel`) is a bug in the calling code, and `is_usage`
// says so.  A lookup that found nothing, an empty index, a full index
// and a buffer too small are answers a correct program meets.  The four
// faults of reading a serialised index are a file to discard, and
// `is_format` says so.

// What an index refused, and the numbers that made it refuse.
//
// ```novo
// use hnswerr
//
// fn main() [io]
//     let f = HnswDimMismatch(768, 384)
//     println(f.message())
// ```
pub enum HnswFault
    // A build parameter outside its range.  `what` names it — "M",
    // "ef_construction", "dim", "ef", "k", "level", "capacity",
    // "level_multiplier" — and `value` is what was asked for, or 0 for
    // the level multiplier, which is not an integer.
    HnswBadParam(what: Str, value: Int)
    // The uniform handed to an insert was not in (0, 1).  A fault rather
    // than a clamp: the number decides which level an element is
    // inserted at, and a clamped 1.0 puts every element on level 0.
    HnswBadUniform(value: Float)
    // A vector of the wrong length.  Usually one model's output handed
    // to an index built for another's: 768 against 384 is `all-mpnet`
    // against `all-MiniLM`.
    HnswDimMismatch(want: Int, got: Int)
    // A vector holding a value that is not finite.  `at` is the
    // coordinate.  Refused rather than stored, because a distance to
    // NaN is NaN and NaN sorts unpredictably.
    HnswNotFinite(at: Int)
    // A vector of all zeros handed to a cosine index or to `normalize`.
    // Its norm is zero, so its cosine is undefined.
    HnswZeroNorm
    // A label no element in the index carries.
    HnswNoSuchLabel(label: Int)
    // A label an element already carries, on an insert.  Labels are
    // the caller's own ids, so a repeat is a caller that lost track, and
    // replacing silently would leave the old vector's edges in the
    // graph.
    HnswDuplicateLabel(label: Int)
    // A search of an index with nothing in it.  The usual cause is a
    // build that failed upstream, so it is a fault rather than an empty
    // answer, and `is_usage` answers false.
    HnswEmptyIndex
    // An index that has reached the capacity it was built with.
    // `hnswparam.HnswParams.capacity` is the number, and
    // `hnswgraph.grow` is what raises it.
    HnswAtCapacity(capacity: Int)
    // A serialised index whose first bytes are not this format's.
    // `got` is the little-endian reading of the first four bytes.
    HnswBadMagic(got: Int)
    // A serialised index from a version of this format that this
    // package does not read.  `hnswio.format_version` is what it
    // writes.
    HnswBadVersion(version: Int)
    // A serialised index that ran out of bytes.  `at` is where the
    // read stopped and `want` is how many more it needed.
    HnswTruncated(at: Int, want: Int)
    // A serialised index that read back inconsistent: a neighbour
    // index off the end, a level above the top, a link count above
    // the parameter.  `what` names the field and `at` the element or
    // the position.
    HnswCorruptGraph(what: Str, at: Int)
    // A writer was handed `room` bytes and needed `want`.  A sizing
    // decision, so `is_usage` answers false; `hnswio.size_bound` is the
    // number to ask for.
    HnswOutputFull(want: Int, room: Int)

// Every `HnswFault` is printed the same way: it names what was
// compared, and prints both sides.
impl Error for HnswFault
    fn message(self) -> Str
        match self
            HnswBadParam(what, value)  => "${what} of ${value} is out of range"
            HnswBadUniform(value)      => "a uniform of ${value} is not in (0, 1)"
            HnswDimMismatch(want, got) => "a vector of ${got} into an index of ${want}"
            HnswNotFinite(at)          => "coordinate ${at} is not a finite number"
            HnswZeroNorm               => "cosine distance is undefined for a zero vector"
            HnswNoSuchLabel(label)     => "no element labelled ${label}"
            HnswDuplicateLabel(label)  => "an element is already labelled ${label}"
            HnswEmptyIndex             => "an index with nothing in it"
            HnswAtCapacity(capacity)   => "the index holds its full ${capacity}"
            HnswBadMagic(got)          => "not a serialised index: first four bytes read ${got}"
            HnswBadVersion(version)    => "index format ${version} is not one this reader knows"
            HnswTruncated(at, want)    => "${want} more byte(s) wanted at ${at}"
            HnswCorruptGraph(what, at) => "${what} at ${at} does not describe this graph"
            HnswOutputFull(want, room) => "${want} byte(s) into room for ${room}"

// Whether the fault is a bug in the calling code rather than an
// ordinary answer or a sizing decision.
//
// True for the parameter and vector faults and for a duplicate label.
// False for the lookup, the empty index, the full index and the full
// buffer, which a correct program meets, and for the four format
// faults.
//
// ```novo
// use hnswerr
//
// fn main() [io]
//     println("${hnswerr.is_usage(HnswEmptyIndex)}")
//     // : false
// ```
pub fn is_usage(f: HnswFault) -> Bool
    match f
        HnswBadParam(_, _)    => true
        HnswBadUniform(_)     => true
        HnswDimMismatch(_, _) => true
        HnswNotFinite(_)      => true
        HnswZeroNorm          => true
        HnswDuplicateLabel(_) => true
        _                     => false

// Whether the fault came from reading a serialised index.
//
// The four `hnswio` faults: `HnswBadMagic`, `HnswBadVersion`,
// `HnswTruncated` and `HnswCorruptGraph`.  A load that fails this way is
// a cache to discard.
pub fn is_format(f: HnswFault) -> Bool
    match f
        HnswBadMagic(_)        => true
        HnswBadVersion(_)      => true
        HnswTruncated(_, _)    => true
        HnswCorruptGraph(_, _) => true
        _                      => false
